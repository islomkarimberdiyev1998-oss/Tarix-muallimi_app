let currentGrade = "6";
let activeTopic = null;
let idx = 0, ball = 0, kombo = 0, javobBerildi = false, ishlatildi50 = false, taymer = null, vaqt = 20;

function showOnly(id) {
    document.getElementById("screen-home").style.display = "none";
    document.getElementById("screen-topic").style.display = "none";
    document.getElementById("screen-quiz").style.display = "none";
    document.getElementById(id).style.display = "block";
}

function goHome() {
    clearInterval(taymer);
    showOnly("screen-home");
}

function openGrade(gradeKey) {
    currentGrade = gradeKey;
    const gradeData = DB.grades[gradeKey];
    const box = document.getElementById("screen-topic");

    if (!gradeData || gradeData.topics.length === 0) {
        box.innerHTML = `
            <h2>📚 ${gradeData ? gradeData.label : gradeKey}</h2>
            <div class="sub" style="color:#fbbf24; margin:25px 0;">⏳ Ushbu boʻlim mavzulari tez kunda qoʻshiladi!</div>
            <button class="back" onclick="goHome()">⬅️ Bosh menyuga qaytish</button>
        `;
        showOnly("screen-topic");
        return;
    }

    let listHtml = "";
    gradeData.topics.forEach(t => {
        const count = t.questions.length;
        const readyClass = count > 0 ? "ready" : "";
        const badgeText = count > 0 ? `${count} savol` : "Tez kunda";
        listHtml += `
            <button class="t-btn ${readyClass}" onclick="selectTopic('${gradeKey}', '${t.id}')">
                <span>${t.title}</span>
                <span class="badge">${badgeText}</span>
            </button>
        `;
    });

    box.innerHTML = `
        <h2>📘 ${gradeData.label}</h2>
        <div class="sub">Mavzuni tanlang (jami ${gradeData.topics.length} ta mavzu):</div>
        <div class="topic-list">${listHtml}</div>
        <button class="back" onclick="goHome()">⬅️ Bosh menyuga qaytish</button>
    `;
    showOnly("screen-topic");
}

function selectTopic(gradeKey, topicId) {
    const topic = DB.grades[gradeKey].topics.find(t => t.id === topicId);
    if (!topic) return;

    if (topic.questions.length === 0) {
        const box = document.getElementById("screen-topic");
        box.innerHTML = `
            <h2>📖 ${topic.title}</h2>
            <div class="sub" style="color:#fbbf24; margin:25px 0;">
                ⏳ Ushbu mavzu uchun test savollari hali kiritilmagan. Tez kunda qoʻshiladi!
            </div>
            <button class="back" onclick="openGrade('${gradeKey}')">⬅️ Mavzular roʻyxatiga qaytish</button>
        `;
        return;
    }

    activeTopic = topic;
    startTest();
}

function startTest() {
    idx = 0; ball = 0; kombo = 0; ishlatildi50 = false;
    loadQ();
}

function loadQ() {
    clearInterval(taymer);
    javobBerildi = false;
    vaqt = 20;
    const savollar = activeTopic.questions;
    const s = savollar[idx];
    const letters = ["A) ", "B) ", "C) ", "D) "];

    let h = `
        <div class="sub" style="margin-bottom:6px; color:#fbbf24;">${activeTopic.title}</div>
        <div class="bar">
            <span>Savol: <b>${idx + 1}/${savollar.length}</b></span>
            ${kombo >= 2 ? `<span class="combo">🔥 x${kombo}</span>` : ""}
            <span>🪙 <b>${ball}</b></span>
        </div>
        <div class="t-bg"><div class="t-fill" id="tfill"></div></div>
        <button class="help" id="b50" onclick="do50()" ${ishlatildi50 ? "disabled" : ""}>💡 50/50</button>
        <div class="q-text">${idx + 1}. ${s.q}</div>
    `;

    s.a.forEach((opt, i) => {
        h += `<button class="opt" id="o${i}" onclick="check(${i})">${letters[i]}${opt}</button>`;
    });

    const qbox = document.getElementById("screen-quiz");
    qbox.innerHTML = h;
    showOnly("screen-quiz");

    taymer = setInterval(() => {
        vaqt -= 0.2;
        const f = document.getElementById("tfill");
        if (f) {
            f.style.width = Math.max(0, (vaqt / 20) * 100) + "%";
            if (vaqt <= 7) f.style.background = "#ef4444";
        }
        if (vaqt <= 0) {
            clearInterval(taymer);
            if (!javobBerildi) {
                javobBerildi = true;
                kombo = 0;
                document.getElementById("o" + s.c).classList.add("ok");
                setTimeout(nextQ, 1200);
            }
        }
    }, 200);
}

function do50() {
    if (ishlatildi50 || javobBerildi) return;
    ishlatildi50 = true;
    document.getElementById("b50").disabled = true;
    const togri = activeTopic.questions[idx].c;
    const xatolar = [0, 1, 2, 3].filter(i => i !== togri).sort(() => Math.random() - 0.5);
    document.getElementById("o" + xatolar[0]).classList.add("hide");
    document.getElementById("o" + xatolar[1]).classList.add("hide");
}

function check(tanlangan) {
    if (javobBerildi) return;
    javobBerildi = true;
    clearInterval(taymer);
    const togri = activeTopic.questions[idx].c;

    if (tanlangan === togri) {
        document.getElementById("o" + tanlangan).classList.add("ok");
        kombo++;
        ball += (kombo >= 2 ? 15 : 10);
    } else {
        document.getElementById("o" + tanlangan).classList.add("no");
        document.getElementById("o" + togri).classList.add("ok");
        kombo = 0;
    }
    setTimeout(nextQ, 1000);
}

function nextQ() {
    idx++;
    if (idx < activeTopic.questions.length) {
        loadQ();
    } else {
        document.getElementById("screen-quiz").innerHTML = `
            <div style="text-align:center;">
                <h2>🏆 Mavzu yakunlandi!</h2>
                <p style="color:#94a3b8; font-size:13px;">${activeTopic.title}</p>
                <p style="color:#fbbf24; font-size:28px; font-weight:bold; margin:14px 0;">🪙 ${ball} ball</p>
                <button class="t-btn ready" style="justify-content:center;" onclick="startTest()">🔄 Qayta ishlash</button>
                <button class="back" onclick="openGrade('${currentGrade}')">📋 Mavzular roʻyxati</button>
                <button class="back" onclick="goHome()">🏠 Bosh menyu</button>
            </div>
        `;
    }
}
</script>

</body>
</html>
