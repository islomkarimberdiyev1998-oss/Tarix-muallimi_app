<!DOCTYPE html>
<html lang="uz">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Tarix Muallim — Mini App</title>
<script src="https://telegram.org/js/telegram-web-app.js"></script>
<style>
* { box-sizing: border-box; }
body {
    font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
    background: linear-gradient(135deg, #0f172a, #1e293b);
    color: #ffffff;
    margin: 0;
    padding: 14px;
    display: flex;
    justify-content: center;
    min-height: 100vh;
}
.card {
    background: rgba(30, 41, 59, 0.95);
    border: 1px solid rgba(251, 191, 36, 0.25);
    border-radius: 18px;
    padding: 18px;
    width: 100%;
    max-width: 440px;
    box-shadow: 0 10px 30px rgba(0, 0, 0, 0.45);
}
h2 { color: #fbbf24; text-align: center; margin: 0 0 6px 0; font-size: 21px; }
.sub { text-align: center; color: #94a3b8; font-size: 13px; margin-bottom: 16px; }
.grid { display: grid; grid-template-columns: 1fr 1fr; gap: 10px; }
.g-btn {
    background: linear-gradient(145deg, #334155, #1e293b);
    border: 1px solid rgba(251, 191, 36, 0.35);
    color: #f8fafc;
    padding: 15px 8px;
    border-radius: 13px;
    font-size: 15px;
    font-weight: 600;
    cursor: pointer;
    transition: 0.15s;
}
.g-btn:active { transform: scale(0.96); }
.g-btn.abitur { grid-column: span 2; border-color: #38bdf8; color: #38bdf8; }
.topic-list { max-height: 62vh; overflow-y: auto; padding-right: 4px; }
.t-btn {
    width: 100%;
    background: #334155;
    color: #f8fafc;
    border: 1px solid #475569;
    padding: 13px 14px;
    border-radius: 12px;
    font-size: 14px;
    font-weight: 500;
    text-align: left;
    cursor: pointer;
    margin-bottom: 8px;
    display: flex;
    justify-content: space-between;
    align-items: center;
    line-height: 1.35;
}
.t-btn.ready {
    background: linear-gradient(90deg, #1d4ed8, #2563eb);
    border-color: #60a5fa;
    font-weight: 600;
}
.badge {
    font-size: 11px;
    padding: 3px 8px;
    border-radius: 8px;
    background: rgba(0, 0, 0, 0.3);
    white-space: nowrap;
    margin-left: 8px;
}
.back {
    width: 100%;
    background: transparent;
    border: 1px solid #64748b;
    color: #cbd5e1;
    padding: 12px;
    border-radius: 12px;
    font-size: 14px;
    margin-top: 10px;
    cursor: pointer;
}
.bar { display: flex; justify-content: space-between; align-items: center; margin-bottom: 10px; font-size: 14px; }
.combo { background: #f59e0b; color: #0f172a; padding: 2px 8px; border-radius: 8px; font-weight: bold; font-size: 12px; }
.t-bg { width: 100%; height: 7px; background: #334155; border-radius: 5px; margin-bottom: 14px; overflow: hidden; }
.t-fill { height: 100%; width: 100%; background: #22c55e; transition: width 0.2s linear; }
.q-text { font-size: 16px; font-weight: 600; margin-bottom: 15px; line-height: 1.45; }
.opt {
    display: block;
    width: 100%;
    padding: 13px;
    margin-bottom: 9px;
    background: #334155;
    color: #fff;
    border: 1px solid #475569;
    border-radius: 11px;
    font-size: 14px;
    text-align: left;
    cursor: pointer;
    line-height: 1.35;
}
.hide { opacity: 0.2; pointer-events: none; }
.ok { background: #16a34a !important; border-color: #4ade80 !important; }
.no { background: #dc2626 !important; border-color: #f87171 !important; }
.help {
    background: rgba(251, 191, 36, 0.15);
    border: 1px solid #fbbf24;
    color: #fbbf24;
    padding: 6px 12px;
    border-radius: 8px;
    font-weight: bold;
    font-size: 13px;
    margin-bottom: 12px;
    cursor: pointer;
}
.help:disabled { opacity: 0.3; }
</style>
</head>
<body>

<div class="card" id="screen-home">
    <h2>⚔️ Tarix Muallim</h2>
    <div class="sub">Sinf yoki boʻlimni tanlang:</div>
    <div class="grid">
        <button class="g-btn" onclick="openGrade('5')">📚 5-sinf</button>
        <button class="g-btn" onclick="openGrade('6')">📚 6-sinf</button>
        <button class="g-btn" onclick="openGrade('7')">📚 7-sinf</button>
        <button class="g-btn" onclick="openGrade('8')">📚 8-sinf</button>
        <button class="g-btn" onclick="openGrade('9')">📚 9-sinf</button>
        <button class="g-btn" onclick="openGrade('10')">📚 10-sinf</button>
        <button class="g-btn" onclick="openGrade('11')">📚 11-sinf</button>
        <button class="g-btn abitur" onclick="openGrade('abituriyent')">🎓 Abituriyent / Milliy sertifikat</button>
    </div>
</div>

<div class="card" id="screen-topic" style="display:none;"></div>
<div class="card" id="screen-quiz" style="display:none;"></div>

