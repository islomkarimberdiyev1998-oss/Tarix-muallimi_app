                        { "q": "Dastlabki urug‘ jamoalari kimning atrofida birlashgan?", "a": ["Erkak kishi", "Ayol – ona", "Qabila boshlig‘i", "Hukmdor"], "c": 1 },
                        { "q": "Nima sababdan insoniyat tarixining boshlanishi «tosh davri» deb ataladi?", "a": ["Odamlar tosh uylarda yashagani uchun", "Toshdan shaharlar qurilgani uchun", "Dastlabki mehnat qurollari toshlardan yasalgani uchun", "Tosh yozuvlar keng tarqalgani uchun"], "c": 2 },
                        { "q": "Tosh davri bosqichlari qaysi javobda to‘g‘ri ko‘rsatilgan?", "a": ["Paleolit, mezolit, neolit, eneolit", "Neolit, bronza, temir, eneolit", "Paleolit, bronza, temir, mezolit", "Mezolit, temir, neolit, bronza"], "c": 0 },
                        { "q": "Eneolit atamasi qanday ma’noni anglatadi?", "a": ["Qadimgi tosh davri", "O‘rta tosh davri", "Yangi tosh davri", "Mis-tosh davri"], "c": 3 }
                    ]
